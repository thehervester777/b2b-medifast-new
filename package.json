{
  "name": "medifast",
  "version": "1.0.0",
  "private": true,
  "description": "MediFast: supplier portal, admin panel and API for pharmacy purchasing.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:supplier": "npm run dev -w apps/supplier",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "build": "npm run build -w apps/admin && npm run build -w apps/supplier",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3"
  }
}
