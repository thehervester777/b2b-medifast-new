# Copy to .env for local use. On cPanel, set these in "Setup Node.js App" > Environment variables instead.

NODE_ENV=production
# Public address of the site, no trailing slash. Used for the cookie "Secure" flag and the Origin check.
APP_URL=https://example.com

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Set to 1 when the app runs behind cPanel's proxy (Passenger) so client IPs are read correctly.
TRUST_PROXY=1

# Optional. Leave empty to let the host choose the port.
PORT=
